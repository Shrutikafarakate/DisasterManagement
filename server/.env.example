NODE_ENV=development
PORT=5000

# Copy the Atlas driver connection string and replace the placeholders.
MONGO_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/disaster_response_platform?retryWrites=true&w=majority

# Replace with a strong, unique secret before running the application.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
